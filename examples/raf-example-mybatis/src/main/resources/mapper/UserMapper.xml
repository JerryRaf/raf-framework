<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.jerryraf.examples.mybatis.dao.UserMapper">

    <!-- Result Map -->
    <resultMap id="BaseResultMap" type="io.github.jerryraf.examples.mybatis.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="age" property="age"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="version" property="version"/>
    </resultMap>

    <!-- Base Column List -->
    <sql id="Base_Column_List">
        id, username, email, age, status, is_deleted,
        create_time, update_time, create_by, update_by, version
    </sql>

    <!-- Custom Query: Find users by age range -->
    <select id="findByAgeRange" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE is_deleted = 0
        AND age BETWEEN #{minAge} AND #{maxAge}
        ORDER BY age ASC
    </select>

    <!-- Custom Query with Pagination: Find active users -->
    <select id="findActiveUsers" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE is_deleted = 0
        AND status = #{status}
        ORDER BY create_time DESC
    </select>

    <!-- Custom Update: Batch update user status -->
    <update id="batchUpdateStatus">
        UPDATE t_user
        SET status = #{status},
        update_time = NOW()
        WHERE id IN
        <foreach collection="userIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND is_deleted = 0
    </update>

</mapper>
