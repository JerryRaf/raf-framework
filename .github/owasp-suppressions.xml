<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        False positive: CVE-2026-33186 is a gRPC-Go vulnerability (authorization bypass via
        missing leading slash in :path header). OWASP dependency-check matches it against
        grpc-java jars via the generic "grpc:grpc" CPE. grpc-java is a separate implementation
        and is not affected by this Go-specific routing flaw.
        Reference: https://nvd.nist.gov/vuln/detail/CVE-2026-33186
    -->
    <suppress>
        <notes>False positive: CVE-2026-33186 is a gRPC-Go vulnerability, not grpc-java. Different language runtime, different routing implementation.</notes>
        <gav regex="true">^io\.grpc:grpc-.*$</gav>
        <cve>CVE-2026-33186</cve>
    </suppress>

    <!--
        False positive: dependency-check matches dubbo-registry-zookeeper's version (3.3.4)
        against ZooKeeper CPE. This jar is Dubbo's registry module, not Apache ZooKeeper itself.
        CVE-2023-44981 affects ZooKeeper < 3.9.1 and is unrelated to Dubbo.
    -->
    <suppress>
        <notes>False positive: dubbo-registry-zookeeper version 3.3.4 is Dubbo's version, not ZooKeeper's version.</notes>
        <gav regex="true">^org\.apache\.dubbo:dubbo.*$</gav>
        <cve>CVE-2023-44981</cve>
    </suppress>

    <!--
        False positive: dependency-check matches logback-adapter version (1.1.3) against
        Nacos CPE. This jar is Nacos's logback adapter module, not Nacos server itself.
        CVE-2021-29441 is a Nacos authentication bypass unrelated to the logback adapter.
    -->
    <suppress>
        <notes>False positive: logback-adapter version 1.1.3 is the adapter module version, not Nacos server version.</notes>
        <gav regex="true">^com\.alibaba\.nacos:logback-adapter.*$</gav>
        <cve>CVE-2021-29441</cve>
    </suppress>

    <!--
        False positive: dependency-check matches rocketmq-logback-classic and rocketmq-slf4j-api
        version (1.0.1) against RocketMQ CPE. These are RocketMQ logging extension libraries
        (io.github.aliyunmq), not the RocketMQ broker. The project uses RocketMQ 5.3.2 which
        is not affected by CVE-2023-33246 and CVE-2023-37582.
    -->
    <suppress>
        <notes>False positive: rocketmq logging extension version 1.0.1 is the extension library version, not RocketMQ broker version.</notes>
        <gav regex="true">^io\.github\.aliyunmq:rocketmq-.*$</gav>
        <cve>CVE-2023-33246</cve>
    </suppress>
    <suppress>
        <notes>False positive: rocketmq logging extension version 1.0.1 is the extension library version, not RocketMQ broker version.</notes>
        <gav regex="true">^io\.github\.aliyunmq:rocketmq-.*$</gav>
        <cve>CVE-2023-37582</cve>
    </suppress>

    <!--
        False positive: dependency-check matches rocketmq-proto (2.0.4) and rocketmq-rocksdb (1.0.2)
        sub-module versions against RocketMQ CPE. These are RocketMQ sub-modules, not the broker.
        The project uses RocketMQ 5.3.2 which is not affected by these CVEs.
    -->
    <suppress>
        <notes>False positive: rocketmq-proto/rocketmq-rocksdb sub-module versions are not RocketMQ broker versions.</notes>
        <gav regex="true">^org\.apache\.rocketmq:(rocketmq-proto|rocketmq-rocksdb).*$</gav>
        <cve>CVE-2023-33246</cve>
    </suppress>
    <suppress>
        <notes>False positive: rocketmq-proto/rocketmq-rocksdb sub-module versions are not RocketMQ broker versions.</notes>
        <gav regex="true">^org\.apache\.rocketmq:(rocketmq-proto|rocketmq-rocksdb).*$</gav>
        <cve>CVE-2023-37582</cve>
    </suppress>

    <!--
