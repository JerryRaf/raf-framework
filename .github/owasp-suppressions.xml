        PostgreSQL CPE. All shardingsphere-*postgresql* jars are ShardingSphere's PostgreSQL
        dialect/parser/statement modules, not PostgreSQL itself.
        CVE-2019-10211, CVE-2015-3166, CVE-2016-7048, CVE-2018-1115, CVE-2015-0244 are
        PostgreSQL vulnerabilities unrelated to ShardingSphere.
    -->
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not PostgreSQL version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-.*postgresql.*$</gav>
        <cve>CVE-2019-10211</cve>
    </suppress>
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not PostgreSQL version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-.*postgresql.*$</gav>
        <cve>CVE-2015-3166</cve>
    </suppress>
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not PostgreSQL version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-.*postgresql.*$</gav>
        <cve>CVE-2016-7048</cve>
    </suppress>
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not PostgreSQL version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-.*postgresql.*$</gav>
        <cve>CVE-2018-1115</cve>
    </suppress>
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not PostgreSQL version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-.*postgresql.*$</gav>
