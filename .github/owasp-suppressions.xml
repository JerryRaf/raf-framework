        <notes>False positive: ShardingSphere version 5.5.1 is not MariaDB version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-infra-database-mariadb.*$</gav>
        <cve>CVE-2012-3163</cve>
    </suppress>
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not MariaDB version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-infra-database-mariadb.*$</gav>
        <cve>CVE-2012-2750</cve>
    </suppress>
    <suppress>
        <notes>False positive: ShardingSphere version 5.5.1 is not MariaDB version 5.5.1.</notes>
        <gav regex="true">^org\.apache\.shardingsphere:shardingsphere-infra-database-mariadb.*$</gav>
        <cve>CVE-2016-9843</cve>
    </suppress>

    <!--
