    <!--
        False positive: CVE-2024-48910 is a DOMPurify vulnerability, incorrectly associated
        with moment.js by dependency-check's JavaScript scanning heuristics.
    -->
    <suppress>
        <notes>False positive: CVE-2024-48910 is a DOMPurify vulnerability, not a moment.js vulnerability.</notes>
        <packageUrl regex="true">^pkg:javascript/moment\.js@.*$</packageUrl>
        <cve>CVE-2024-48910</cve>
    </suppress>

    <!--
        knife4j-openapi3-ui bundles frontend assets (axios) inside the jar.
        These cannot be upgraded independently — knife4j 4.5.x does not ship updated axios.
        CVE-2025-62718 and CVE-2026-42043 affect the bundled axios JS files (UI-only risk).
        Suppressed via packageUrl because OWASP identifies bundled JS as pkg:javascript, not Maven GAV.
        Re-evaluate when knife4j releases a version with updated frontend dependencies.
    -->
    <suppress>
        <notes>knife4j bundled axios@0.27.2 — UI-only risk, cannot upgrade independently.</notes>
        <packageUrl regex="true">^pkg:javascript/axios@0\.27\..*$</packageUrl>
        <cve>CVE-2025-62718</cve>
    </suppress>
    <suppress>
        <notes>knife4j bundled axios@0.27.2 — UI-only risk, cannot upgrade independently.</notes>
        <packageUrl regex="true">^pkg:javascript/axios@0\.27\..*$</packageUrl>
        <cve>CVE-2026-42043</cve>
    </suppress>
    <suppress>
        <notes>knife4j bundled axios@0.21.4 — UI-only risk, cannot upgrade independently.</notes>
        <packageUrl regex="true">^pkg:javascript/axios@0\.21\..*$</packageUrl>
        <cve>CVE-2025-62718</cve>
    </suppress>
    <suppress>
        <notes>knife4j bundled axios@0.21.4 — UI-only risk, cannot upgrade independently.</notes>
        <packageUrl regex="true">^pkg:javascript/axios@0\.21\..*$</packageUrl>
        <cve>CVE-2026-42043</cve>
    </suppress>

</suppressions>
